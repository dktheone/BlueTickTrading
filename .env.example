# ------------------------------------------------------------------------------
# SQLITE3 DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Optional custom database path (defaults to ./data/leads.db)
SQLITE_DB_PATH=./data/leads.db

# ------------------------------------------------------------------------------
# HOSTINGER EMAIL CONFIGURATION (METHOD 1: WEBMAIL SMTP - RECOMMENDED)
# ------------------------------------------------------------------------------
# Hostinger SMTP Host
SMTP_HOST=smtp.hostinger.com
# Port 465 (SSL - recommended) or Port 587 (TLS)
SMTP_PORT=465
SMTP_SECURE=true
# Your Hostinger Webmail email address
SMTP_USER=info@blueticktradingschool.com
# Your Hostinger Webmail email password
SMTP_PASS=AGupta@#$0291884
# Sender name & address as shown in recipient's inbox
SMTP_FROM="Blue Tick Trading School" <info@blueticktradingschool.com>
# Where lead alert emails should be delivered (e.g. mentor/admin email)
ADMIN_NOTIFICATION_EMAIL=info@blueticktradingschool.com

# ------------------------------------------------------------------------------
# HOSTINGER MAIL REST API CONFIGURATION (METHOD 2: OPTIONAL ALTERNATIVE)
# Ref: https://api.mail.hostinger.com/#tag/send/POST/api/v1/mailboxes/{mailboxResourceId}/send
# ------------------------------------------------------------------------------
# Hostinger API Token from hPanel -> Account -> API Tokens
HOSTINGER_MAIL_API_TOKEN=f86fd3e735c0803199131e7cbac460f1f757e85ee18d8b653f8fa4fcdd54cc88
# Mailbox Resource ID from Hostinger Email panel
HOSTINGER_MAILBOX_RESOURCE_ID=

